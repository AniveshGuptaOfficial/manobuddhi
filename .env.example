# Copy to .env and edit. Never commit .env.
MB_ENV=dev

# Model pair (Config B shown; for Config A set MB_MODE=single_model_nothink_think)
MB_MODE=small_large
MB_FAST_MODEL=Qwen/Qwen2.5-1.5B-Instruct
MB_SLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
MB_K_FAST_SAMPLES=3

MB_THRESHOLD_MODE=budget_driven
MB_FIXED_THRESHOLD=0.5
MB_DEFAULT_LATENCY_BUDGET_MS=1500

# Postgres + Redis (match docker-compose.yml)
MB_PG_USER=manobuddhi
MB_PG_PASSWORD=change-me
MB_PG_DB=manobuddhi
MB_DATABASE_URL=postgresql+psycopg://manobuddhi:change-me@127.0.0.1:5432/manobuddhi
MB_REDIS_URL=redis://127.0.0.1:6379/0

# vLLM servers (used from F4)
MB_VLLM_FAST_URL=http://localhost:8100/v1
MB_VLLM_SLOW_URL=http://localhost:8200/v1

MB_SEED=42

# Optional: Kaggle API credentials (alternative to ~/.kaggle/kaggle.json)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key
